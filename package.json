{
  "name": "homelib-packages",
  "private": true,
  "repository": "https://github.com/homelib/homelib.git",
  "license": "MIT",
  "author": "vilicvane",
  "type": "module",
  "scripts": {
    "3": "npm install && npm dedupe && npm install",
    "build": "rimraf --glob packages/*/bld && tsc --build",
    "lint": "eslint --no-error-on-unmatched-pattern --report-unused-disable-directives .",
    "lint-prettier": "prettier --check .",
    "bare-test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test": "npm run lint-prettier && npm run build && npm run lint && npm run bare-test",
    "core": "npm run --workspace @homelib/core",
    "playground": "npm run --workspace @homelib/playground",
    "terminal": "npm run --workspace @homelib/terminal",
    "utils": "npm run --workspace @homelib/utils",
    "web": "npm run --workspace @homelib/web",
    "xiaomi": "npm run --workspace @homelib/xiaomi"
  },
  "workspaces": [
    "packages/core",
    "packages/playground",
    "packages/terminal",
    "packages/utils",
    "packages/web",
    "packages/xiaomi"
  ],
  "devDependencies": {
    "@mufan/eslint-plugin": "^0.3.1",
    "@types/jest": "^30.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  }
}
