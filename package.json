{
  "name": "homelib-packages",
  "private": true,
  "license": "MIT",
  "author": "vilicvane",
  "type": "module",
  "scripts": {
    "3": "pnpm install && pnpm dedupe && pnpm install",
    "build": "rimraf --glob packages/*/{.bld,bld} && tsc --build",
    "lint": "eslint --no-error-on-unmatched-pattern --report-unused-disable-directives .",
    "lint-prettier": "prettier --check .",
    "test": "npm run lint-prettier && npm run build && npm run lint && npm run bare-test && pnpm bare-test",
    "bare-test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "cli": "node --enable-source-maps packages/cli/bin/run.js",
    "core": "pnpm --filter @homelib/core",
    "dashboard": "pnpm --filter @homelib/dashboard",
    "http": "pnpm --filter @homelib/http",
    "universal": "pnpm --filter @homelib/universal",
    "x": "pnpm --filter @homelib/x",
    "xiaomi": "pnpm --filter @homelib/xiaomi",
    "homelib": "pnpm --filter homelib"
  },
  "devDependencies": {
    "@homelib/core": "workspace:*",
    "@homelib/universal": "workspace:*",
    "@mufan/eslint-plugin": "file:../../mufancom/code/packages/eslint-plugin",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.2.0",
    "homelib": "workspace:*",
    "jest": "^30.3.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "run-in-every": "^0.2.0",
    "typescript": "^6.0.2"
  }
}
