{
  "$schema": "boilerplate.schema.json",
  "boilerplate": "@mufan/code-boilerplates/typescript",
  "options": {
    "name": "homelib-packages",
    "license": "MIT",
    "author": "vilicvane",
    "defaultBranch": "master",
    "packageManager": "npm",
    "packages": [
      {
        "name": "@homelib/core",
        "projects": [
          {
            "name": "exports",
            "type": "library",
            "exports": false
          },
          {
            "name": "library",
            "test": true
          },
          {
            "name": "web",
            "noEmit": true,
            "test": true,
            "references": ["library"]
          }
        ]
      },
      {
        "name": "@homelib/xiaomi",
        "projects": [
          {
            "name": "library",
            "test": true,
            "references": [
              {
                "package": "@homelib/core",
                "project": "library"
              }
            ]
          },
          {
            "name": "experiments",
            "references": ["library"]
          }
        ]
      },
      {
        "name": "@homelib/playground",
        "projects": [
          {
            "name": "program",
            "references": [
              {
                "package": "@homelib/core",
                "project": "library"
              },
              {
                "package": "@homelib/core",
                "project": "web"
              },
              {
                "package": "@homelib/xiaomi",
                "project": "library"
              }
            ]
          }
        ]
      }
    ]
  }
}
